{
  "name": "clearcase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "gate": "bun scripts/gate.mjs",
    "gate:hosted": "bun scripts/gate-hosted.mjs",
    "check": "svelte-kit sync && bun run --bun check:hosted-imports && tsc --noEmit -p . && bun scripts/case-package/export-schemas.ts --check && bun scripts/case-package/schema-check.ts && bun scripts/pilot/generate-view-registry.ts --check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && bun scripts/check-links.mjs && bun scripts/ci/source-check.ts",
    "build": "vite build && bun scripts/pilot/copy-pdfjs.ts",
    "test": "vitest run",
    "fixtures:generate": "bun scripts/fixtures/generate.ts",
    "test:e2e": "bun tests/e2e/pilot/run.mjs",
    "verify:pilot:v5": "bun tests/e2e/pilot/v5-lanes.mjs",
    "parity": "bun scripts/parity/run.mjs",
    "measure": "bun scripts/measure/index.ts",
    "start": "bun scripts/pilot/start.ts",
    "build:hosted": "bun scripts/pilot/hosted.ts build",
    "start:hosted": "bun scripts/pilot/hosted.ts start",
    "test:hosted": "bun scripts/pilot/hosted.ts test",
    "convert": "bun scripts/case-package/cli.ts convert",
    "validate": "bun scripts/case-package/cli.ts validate",
    "verify:package": "bun scripts/case-package/verify-package.ts",
    "check:hosted-imports": "bun scripts/ci/hosted-imports.ts",
    "probe:hosted-imports": "bun tests/hosted-foundation/runtime/guard-mutations.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.26.0",
    "@cloudflare/puppeteer": "1.4.0",
    "@kenjiuno/msgreader": "1.29.0",
    "buffer": "6.0.3",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "postal-mime": "4.0.11",
    "tabulator-tables": "6.6.1",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@sveltejs/adapter-cloudflare": "8.0.1",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.4",
    "jsdom": "27.4.0",
    "pdfjs-dist": "6.4.299",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "workerd": "1.20261012.1",
    "wrangler": "4.151.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
