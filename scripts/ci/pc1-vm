#!/bin/bash
# Creates, provisions, registers, reaches and destroys the ClearCase CI runner VM on pc1 from a workstation with root
# SSH to pc1 and an admin `gh` login. See docs/ci-runner.md.
set -euo pipefail
here=$(cd "${BASH_SOURCE[0]%/*}" && pwd)
host=${CLEARCASE_CI_HOST:-root@ci-host.example.invalid}
state=${CLEARCASE_CI_STATE:-$HOME/.config/clearcase-ci}
key=$state/pc1-vm_ed25519
repo=GridShift-Software/clearcase
name=clearcase-pc1-vm

# The service allows only 127.0.0.57 on pc1's loopback, so socat on pc1 binds that source address for the forward.
guest() {
  ssh -i "$key" -o IdentitiesOnly=yes -o UserKnownHostsFile="$state/known_hosts" -o HostKeyAlias=$name \
    -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 \
    -o ProxyCommand="ssh $host socat - TCP:127.0.0.57:2257,bind=127.0.0.57" ciadmin@127.0.0.57 "$@"
}
wait_guest() {
  local answered= rc
  for _ in $(seq 60); do
    if guest true 2>/dev/null; then
      answered=1
      rc=0
      guest cloud-init status --wait >/dev/null 2>&1 || rc=$?
      # 2 is cloud-init finished degraded, which a booted guest with working SSH tolerates.
      [[ $rc == 0 || $rc == 2 ]] && return
    fi
    sleep 5
  done
  if [[ -n $answered ]]; then echo "pc1-vm: the guest answers SSH but cloud-init reports an error (exit $rc)" >&2
  else echo "pc1-vm: the guest did not answer SSH within 5 minutes" >&2; fi
  return 1
}
runner_id() { gh api "repos/$repo/actions/runners" --jq ".runners[] | select(.name == \"$name\") | .id"; }
# provision, refresh and restart stop the runner or the VM, which would kill a running job. Fails closed: a GitHub API
# error, a missing runner or an unreadable busy flag all refuse. Only `create` provisions a VM that isn't registered yet.
not_busy() {
  local busy
  busy=$(gh api "repos/$repo/actions/runners" --jq ".runners[] | select(.name == \"$name\") | .busy") ||
    { echo "pc1-vm: could not read $name's state from GitHub; fix gh access and retry" >&2; exit 1; }
  case $busy in
  false) ;;
  true) echo "pc1-vm: $name is running a job; try again when it is idle" >&2; exit 1 ;;
  *) echo "pc1-vm: GitHub does not list a runner named $name; run register first, or use start, stop or status" >&2; exit 1 ;;
  esac
}
provision_guest() {
  guest 'sudo tee /usr/local/sbin/clearcase-ci-guest >/dev/null && sudo chmod 0755 /usr/local/sbin/clearcase-ci-guest' \
    <"$here/guest-provision.sh"
  release=$(gh api repos/actions/runner/releases/latest \
    --jq '(.tag_name | ltrimstr("v")) + " " + (.body | capture("<!-- BEGIN SHA linux-x64 -->(?<h>[0-9a-f]{64})").h)')
  guest sudo clearcase-ci-guest provision $release
}

case ${1:-} in
create)
  install -d -m 0700 "$state"
  [[ -f $key ]] || ssh-keygen -q -t ed25519 -N '' -C $name -f "$key"
  rm -f "$state/known_hosts"
  ssh "$host" bash -s -- setup "'$(cat "$key.pub")'" <"$here/vm-host.sh"
  wait_guest
  provision_guest
  "$0" register
  ;;
provision)
  not_busy
  provision_guest
  ;;
register)
  # The short-lived registration token goes straight from gh to the guest's stdin.
  gh api -X POST "repos/$repo/actions/runners/registration-token" --jq .token | guest sudo clearcase-ci-guest register
  ;;
ssh)
  shift
  guest "$@"
  ;;
refresh)
  # Rewrite the service unit and firewall table with pc1's current networks and restart the VM; the disk and the runner
  # stay.
  not_busy
  ssh "$host" bash -s -- unit <"$here/vm-host.sh"
  wait_guest
  ;;
start | stop | restart | status)
  [[ $1 != restart ]] || not_busy
  ssh "$host" systemctl "$1" --no-pager clearcase-ci-vm.service
  ;;
destroy)
  id=$(runner_id)
  [[ -z $id ]] || gh api -X DELETE "repos/$repo/actions/runners/$id"
  ssh "$host" bash -s -- destroy <"$here/vm-host.sh"
  rm -f "$state/known_hosts"
  ;;
*)
  echo "usage: scripts/ci/pc1-vm create | provision | register | refresh | ssh [COMMAND] | start | stop | restart | status | destroy" >&2
  exit 2
  ;;
esac
