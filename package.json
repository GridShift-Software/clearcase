{
  "name": "clearcase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "check": "tsc --noEmit -p . && bun scripts/case-package/export-schemas.ts --check && bun scripts/case-package/schema-check.ts",
    "test": "vitest run",
    "measure": "bun scripts/case-package/measure.ts",
    "convert": "bun scripts/case-package/cli.ts convert",
    "validate": "bun scripts/case-package/cli.ts validate",
    "verify:package": "bun scripts/case-package/verify-package.ts"
  },
  "dependencies": {
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@types/node": "26.6.4",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
