{
  "compilerOptions": {
    "target": "es2024",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "*.ts",
    "../../../../deploy/native-alpha/workers-dev-bootstrap.ts",
    "../../../../deploy/native-alpha/pipeline.ts",
    "../../../../deploy/probes/target.ts"
  ]
}
