// SYNTHETIC native-profile Wrangler config for client-a (unit fixture only). The account and zone are the approved
// native scope's; the D1 UUID is synthetic and no Cloudflare account holds it. Checked by deploy/probes/target.ts
// --profile native against target.json; never applied by this repository.
{
  "name": "cc-sbx-a-20261023",
  "account_id": "fb4c31b91c5d89b7a54afbdc34823170",
  "main": "artifact/cloudflare/_worker.js",
  "no_bundle": true,
  "find_additional_modules": false,
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_als"],
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "a.sandbox.gridshift.co.za", "zone_id": "db7c322907320aba562d64015ee7d673", "custom_domain": true }],
  "limits": { "cpu_ms": 1000 },
  "assets": { "directory": "artifact/public", "binding": "ASSETS" },
  "vars": { "CLEARCASE_CLIENT_ID": "client-a" },
  "secrets": { "required": ["CLERK_SECRET_KEY"] },
  "d1_databases": [{ "binding": "DB", "database_name": "cc-sbx-a-20261023-db", "database_id": "00000000-0000-4000-8000-0000000a0107", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "cc-sbx-a-20261023-files", "jurisdiction": "eu" }]
}
