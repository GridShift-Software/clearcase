# Every variable the journeys read. Copy to an ignored file (for example .local/journeys.env), fill in the values for the
# case under test and `set -a; . .local/journeys.env; set +a` before running. Nothing here is committed with a value.

# Where and how
MODE=
BASE_URL=
RESULTS_DIR=
CLEARCASE_BROWSER_LOCK=
CHROMIUM_PATH=

# The case under test
CASE_ID=
RESULTS_VERSION=
EXPECTED_DOCUMENTS=
EXPECTED_SHA=
# Optional: how many Heads of argument entries the case holds (0 for none); unset accepts either
HEADS_EXPECTED=

# The three PDF samples (a small, a medium and the largest original) and the optional bundle names and byte sizes
SMALL_REF=
MEDIUM_REF=
LARGE_REF=
SMALL_BUNDLE=
MEDIUM_BUNDLE=
LARGE_BUNDLE=
SMALL_BYTES=
MEDIUM_BYTES=
LARGE_BYTES=
SEARCH_REF=
# Optional: a known scanned original (CCITT, JBIG2 or JPX images) whose page 1 J4 requires to draw ink, and its bundle
SCAN_DOCUMENT_REF=
SCAN_DOCUMENT_BUNDLE=

# Signing in (hosted)
CREDENTIALS_JSON=
STORAGE_STATE=
SIGN_IN_PATH=
SIGN_IN_MS=
SIGN_IN_DEVICE=

# Behaviour
IDLE_MINUTES=
READ_ONLY=
DEADLINE_DATE=
BUNDLE_MS=
RUN_ID=

# The data directory the local app was started with; when set, writes are refused against any other instance
CLEARCASE_DATA_DIR=
